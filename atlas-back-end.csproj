<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>atlas_back_end</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Impede a API de compilar os arquivos do projeto filho. -->
    <Compile Remove="AtlasComex.Infrastructure/**/*.cs" />

    <!-- Permite que a API use a infraestrutura. -->
    <ProjectReference Include="AtlasComex.Infrastructure\AtlasComex.Infrastructure.csproj" />
  </ItemGroup>

</Project>